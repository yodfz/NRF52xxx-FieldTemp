# Release 签名配置模板
#
# 用法：复制本文件为同目录下的 keystore.properties 并填入真实值。
# keystore.properties 已被 .gitignore 排除，不会进入 Git，也不会进入 src.zip。
# 缺少该文件时，assembleRelease 会退回 Android 调试密钥签名；产物仅供本地联调，不可分发或上架。
#
# 生成密钥库示例（请自行妥善保管 .jks 与口令，丢失后无法升级同名应用）：
#   keytool -genkeypair -v -keystore panda-release.jks -alias panda \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile 支持相对于 source/ 目录的路径，也支持绝对路径。

storeFile=../panda-release.jks
storePassword=CHANGE_ME
keyAlias=panda
keyPassword=CHANGE_ME
